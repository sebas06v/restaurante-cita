# Copie este archivo a .env y ponga su llave. .env está ignorado por git.
# La llave se saca en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Opcionales
# DEEPSEEK_MODEL=deepseek-chat      # o deepseek-reasoner
# GUAYACAN_PIN=2408                 # PIN del panel de sala

# Cola de correos. Sin REDIS_URL la cola corre en memoria (se pierde al reiniciar).
# Con Docker:  docker run -d -p 6379:6379 redis:7-alpine
# REDIS_URL=redis://127.0.0.1:6379

# Envío real de correos. Sin esto, quedan en la bandeja del panel.
# RESEND_API_KEY=re_...
# MAIL_FROM=El Guayacán <reservas@sudominio.com>

# Para los enlaces dentro de los correos
# PUBLIC_URL=https://su-app.onrender.com

# Cuántas horas antes sale el recordatorio (default 24)
# GUAYACAN_RECORDATORIO_HORAS=24
