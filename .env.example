# Copie este archivo a .env y ponga su llave. .env está ignorado por git.
# La llave se saca en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Opcionales
# DEEPSEEK_MODEL=deepseek-chat      # o deepseek-reasoner
# GUAYACAN_PIN=2408                 # PIN del panel de sala

# Cola de correos. Sin REDIS_URL la cola corre en memoria (se pierde al reiniciar).
# Con Docker:  docker run -d -p 6379:6379 redis:7-alpine
# REDIS_URL=redis://127.0.0.1:6379

# ── Envío real de correos ─────────────────────────────────────────────
# Sin ninguna de estas, los correos quedan en la bandeja del panel.
# Escoja UN camino. Se prefieren en este orden: SMTP, Brevo, Resend.

# A) SMTP — le llega a CUALQUIERA y no necesita dominio propio.
#    Gmail: active la verificación en dos pasos y cree una contraseña de
#    aplicación en https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=sucorreo@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM=El Guayacán <sucorreo@gmail.com>

# B) Brevo — también a cualquiera, por HTTP (no lo bloquea ningún firewall).
#    Basta verificar UN correo remitente, no un dominio entero.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=El Guayacán <sucorreo@gmail.com>

# C) Resend — el mejor para volumen, pero exige dominio propio verificado.
#    Sin dominio solo le llega al correo dueño de la cuenta.
# RESEND_API_KEY=re_...
# MAIL_FROM=El Guayacán <reservas@sudominio.com>

# Para los enlaces dentro de los correos
# PUBLIC_URL=https://su-app.onrender.com

# Cuántas horas antes sale el recordatorio (default 24)
# GUAYACAN_RECORDATORIO_HORAS=24
